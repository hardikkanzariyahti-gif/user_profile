// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  password          String
  profile_picture   String?       @map("profile picture")
  profile_pictures  String[]      @default([]) @map("profile_pictures")
  profileDescriptor Json?         @map("profile_descriptor")
  galleryItems      GalleryItem[]
  albums            Album[]

  @@map("users")
}

model GalleryItem {
  id                Int            @id @default(autoincrement())
  url               String         @unique
  uploadedAt        DateTime       @default(now())
  userId            Int?
  user              User?          @relation(fields: [userId], references: [id])
  isProfile         Boolean        @default(false)
  recognizedUserIds Int[]          @default([])
  faceDescriptors   Json?
  hashtags          Hashtag[]      @relation("GalleryItemHashtags")
  metadata          ImageMetadata?
  albums            Album[]        @relation("AlbumToGalleryItem")
}

model Hashtag {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  items GalleryItem[] @relation("GalleryItemHashtags")
}

model ImageMetadata {
  id            Int         @id @default(autoincrement())
  galleryItemId Int         @unique
  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  personCount   Int         @default(0)
  dominantColor String?
  aspectRatio   Float?
  orientation   String?
  rawJson       Json?       @default("{}")
}

model Album {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  isGlobal    Boolean       @default(true)
  shareId     String        @unique @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime      @default(now())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  items       GalleryItem[] @relation("AlbumToGalleryItem")

  @@map("albums")
}
