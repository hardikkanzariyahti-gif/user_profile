// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  password          String
  profile_picture   String?       @map("profile picture")
  profileDescriptor Json?         @map("profile_descriptor")
  galleryItems      GalleryItem[]
  albums            Album[]

  @@map("users")
}

model GalleryItem {
  id                Int      @id @default(autoincrement())
  url               String
  uploadedAt        DateTime @default(now())
  label             String?
  isProfile         Boolean  @default(false)
  userId            Int?
  recognizedUserIds Int[]    @default([])
  hashtags          String[] @default([])
  faceDescriptors   Json?    @map("face_descriptors")

  user User? @relation(fields: [userId], references: [id])

  albums Album[] @relation("AlbumItems")

  @@map("gallery")
}

model Album {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  isGlobal    Boolean       @default(true)
  shareId     String        @unique @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime      @default(now())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  items       GalleryItem[] @relation("AlbumItems")

  @@map("albums")
}

