generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  password          String
  profile_picture   String?       @map("profile picture")
  profile_pictures  String[]      @default([]) @map("profile_pictures")
  profileDescriptor Json?         @map("profile_descriptor")
  galleryItems      GalleryItem[]
  albums            Album[]

  @@map("users")
}

model GalleryItem {
  id                 Int                  @id @default(autoincrement())
  url                String               @unique
  uploadedAt         DateTime             @default(now())
  userId             Int?
  isProfile          Boolean              @default(false)
  recognizedUserIds  Int[]                @default([])
  faceDescriptors    Json?
  scanStatus         String?              @default("pending")
  metadataStatus     String?              @default("pending")
  user               User?                @relation(fields: [userId], references: [id])
  metadata           ImageMetadata?
  people             ImagePeople[]
  albums             Album[]
  hashtags           Hashtag[]            @relation("GalleryItemHashtags")

  @@index([uploadedAt])
  @@index([userId])
}

model Hashtag {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  items GalleryItem[] @relation("GalleryItemHashtags")
}

model ImageMetadata {
  id            Int         @id @default(autoincrement())
  galleryItemId Int         @unique
  personCount   Int         @default(0)
  dominantColor String?
  aspectRatio   Float?
  orientation   String?
  rawJson       Json?       @default("{}")
  objects       Json?       @default("[]")
  ocrText       String[]    @default([])
  scenes        Json?       @default("[]")
  
  // Architectural Additions (Requirement 1)
  description     String?
  aiSummary       String?
  scene           Json?       @default("[]")
  detectedObjects Json?       @default("[]")
  hashtags        Json?       @default("[]")
  ocrTextJson     Json?       @default("[]") @map("ocrText_json")
  peopleCount     Int?        @default(0)
  eventName       String?
  location        String?
  generatedAt     DateTime?
  metadataVersion Int?        @default(1)
  lastMetaError   String?

  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
}

model ImagePeople {
  id            Int         @id @default(autoincrement())
  galleryItemId Int
  userId        Int?
  userName      String?
  boundingBox   Json?
  confidence    Float?
  isManualTag   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  lastScanError String?
  
  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  
  @@map("image_people")
  @@index([galleryItemId])
  @@index([userId])
}

model Album {
  id                 Int                  @id @default(autoincrement())
  title              String
  description        String?
  isGlobal           Boolean              @default(true)
  shareId            String               @unique @default(dbgenerated("gen_random_uuid()"))
  createdAt          DateTime             @default(now())
  userId             Int
  items              GalleryItem[]
  user               User                 @relation(fields: [userId], references: [id])

  @@map("albums")
}

